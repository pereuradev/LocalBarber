DirectoryIndex index.html
Options -Indexes

# Bloqueia também arquivos dentro de diretórios ocultos, como .git/config.
# FilesMatch sozinho verifica somente o nome final do arquivo.
RedirectMatch 403 "(^|/)\."
RedirectMatch 403 "(?i)(^|/)(vendor|src|views|config)(/|$)"
<FilesMatch "^composer\.(json|lock)$">
    Require all denied
</FilesMatch>

# Impede acesso HTTP direto a .env e outros arquivos ocultos.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# As telas autenticadas mudam com frequência e compartilham o mesmo layout.
# Evita que o navegador misture versões antigas e novas da sidebar.
<IfModule mod_headers.c>
    <FilesMatch "^(agenda|clientes|equipe|faturamento|minha-barbearia|servicos|transacoes)\.html$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>
