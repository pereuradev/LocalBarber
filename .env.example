# Copie este arquivo para .env e substitua os valores abaixo.
# Nunca coloque credenciais reais neste arquivo de exemplo.

SUPABASE_DB_HOST=aws-0-SUA-REGIAO.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO
SUPABASE_DB_SCHEMA=locaalbarber

# Configuracao publica usada pelo Supabase Auth no navegador.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA
